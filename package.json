{
  "name": "plan-my-project",
  "displayName": "Plan My Project",
  "description": "Research-first, goal-anchored AI planning and implementation for VS Code workspaces.",
  "icon": "media/marketplace-icon.png",
  "version": "2.0.0",
  "publisher": "aypande",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/apFire/PlanMyProject.git"
  },
  "homepage": "https://github.com/apFire/PlanMyProject#readme",
  "bugs": {
    "url": "https://github.com/apFire/PlanMyProject/issues"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "keywords": [
    "project planning",
    "task management",
    "copilot",
    "claude",
    "openai",
    "ai",
    "markdown",
    "productivity"
  ],
  "categories": [
    "Other"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "PlanMyProject reads and writes workspace files to maintain plans and apply implementation changes."
    }
  },
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "workspaceContains:planmyproject.md",
    "workspaceContains:projectplan.md",
    "onView:planmyproject.tree"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "planmyproject.openPlan",
        "title": "PlanMyProject: Open Plan"
      },
      {
        "command": "planmyproject.planTask",
        "title": "PlanMyProject: Plan Task (One Level)",
        "icon": {
          "light": "media/plan.svg",
          "dark": "media/plan.svg"
        }
      },
      {
        "command": "planmyproject.addTask",
        "title": "PlanMyProject: Add Task",
        "icon": {
          "light": "media/add.svg",
          "dark": "media/add.svg"
        }
      },
      {
        "command": "planmyproject.addRootTask",
        "title": "PlanMyProject: Add Root Task",
        "icon": {
          "light": "media/add.svg",
          "dark": "media/add.svg"
        }
      },
      {
        "command": "planmyproject.drillDown",
        "title": "PlanMyProject: Drill Down Task",
        "icon": {
          "light": "media/drill.svg",
          "dark": "media/drill.svg"
        }
      },
      {
        "command": "planmyproject.implementTask",
        "title": "PlanMyProject: Implement Task",
        "icon": {
          "light": "media/execute.svg",
          "dark": "media/execute.svg"
        }
      },
      {
        "command": "planmyproject.deleteTask",
        "title": "PlanMyProject: Delete Task",
        "icon": {
          "light": "media/delete.svg",
          "dark": "media/delete.svg"
        }
      },
      {
        "command": "planmyproject.rebuildQueue",
        "title": "PlanMyProject: Rebuild Execution Queue",
        "icon": {
          "light": "media/queue.svg",
          "dark": "media/queue.svg"
        }
      },
      {
        "command": "planmyproject.refreshTree",
        "title": "PlanMyProject: Refresh Tree",
        "icon": {
          "light": "media/refresh.svg",
          "dark": "media/refresh.svg"
        }
      },
      {
        "command": "planmyproject.cancelActiveRequest",
        "title": "PlanMyProject: Cancel Active Request",
        "icon": {
          "light": "media/cancel.svg",
          "dark": "media/cancel.svg"
        }
      },
      {
        "command": "planmyproject.setProjectGoal",
        "title": "PlanMyProject: Set Project Goal",
        "icon": {
          "light": "media/goal.svg",
          "dark": "media/goal.svg"
        }
      },
      {
        "command": "planmyproject.refreshScan",
        "title": "PlanMyProject: Refresh Scan",
        "icon": {
          "light": "media/scan.svg",
          "dark": "media/scan.svg"
        }
      },
      {
        "command": "planmyproject.debateTask",
        "title": "PlanMyProject: Debate Task",
        "icon": {
          "light": "media/debate.svg",
          "dark": "media/debate.svg"
        }
      },
      {
        "command": "planmyproject.markResearchComplete",
        "title": "PlanMyProject: Mark Research Complete",
        "icon": {
          "light": "media/complete.svg",
          "dark": "media/complete.svg"
        }
      },
      {
        "command": "planmyproject.showTaskRationale",
        "title": "PlanMyProject: Show Task Rationale"
      },
      {
        "command": "planmyproject.viewLinkedFiles",
        "title": "PlanMyProject: View Linked Files"
      },
      {
        "command": "planmyproject.importGoalStatement",
        "title": "PlanMyProject: Import Goal Statement"
      },
      {
        "command": "planmyproject.exportPlanSummary",
        "title": "PlanMyProject: Export Plan Summary"
      },
      {
        "command": "planmyproject.viewResearchIndex",
        "title": "PlanMyProject: View Research Index"
      },
      {
        "command": "planmyproject.viewDebateArchive",
        "title": "PlanMyProject: View Debate Archive"
      },
      {
        "command": "planmyproject.setTaskFileSendPolicy",
        "title": "PlanMyProject: Set Task File Send Policy",
        "icon": {
          "light": "media/policy.svg",
          "dark": "media/policy.svg"
        }
      },
      {
        "command": "planmyproject.scanTask",
        "title": "PlanMyProject: Scan Task",
        "icon": {
          "light": "media/scan.svg",
          "dark": "media/scan.svg"
        }
      },
      {
        "command": "planmyproject.inferTasksFromScan",
        "title": "PlanMyProject: Infer Tasks From Scan",
        "icon": {
          "light": "media/scan.svg",
          "dark": "media/scan.svg"
        }
      },
      {
        "command": "planmyproject.undoLastChange",
        "title": "Undo Last Change",
        "category": "PlanMyProject"
      },
      {
        "command": "planmyproject.setApiKey",
        "title": "Set API Key",
        "category": "PlanMyProject"
      }
    ],
    "keybindings": [
      {
        "command": "planmyproject.planTask",
        "key": "alt+p",
        "when": "editorTextFocus && workbenchState != 'empty'"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "planmyproject",
          "title": "PlanMyProject",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "planmyproject": [
        {
          "id": "planmyproject.tree",
          "name": "Implementation Tree"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "planmyproject.tree",
        "contents": "No tasks yet.\n\n[Add Root Task](command:planmyproject.addRootTask)\n[Set Project Goal](command:planmyproject.setProjectGoal)",
        "when": "planmyproject.workspaceOpen && planmyproject.treeEmpty"
      },
      {
        "view": "planmyproject.tree",
        "contents": "PlanMyProject requires an open folder or workspace.\n\n[Open Folder or Workspace](command:vscode.openFolder)",
        "when": "!planmyproject.workspaceOpen"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "planmyproject.addRootTask",
          "when": "view == planmyproject.tree && planmyproject.workspaceOpen",
          "group": "navigation@1"
        },
        {
          "command": "planmyproject.refreshTree",
          "when": "view == planmyproject.tree && planmyproject.workspaceOpen",
          "group": "navigation@2"
        },
        {
          "command": "planmyproject.refreshScan",
          "when": "view == planmyproject.tree && planmyproject.workspaceOpen",
          "group": "navigation@3"
        },
        {
          "command": "planmyproject.rebuildQueue",
          "when": "view == planmyproject.tree && planmyproject.workspaceOpen",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "planmyproject.addTask",
          "when": "view == planmyproject.tree && viewItem =~ /^task:/",
          "group": "inline@1"
        },
        {
          "command": "planmyproject.planTask",
          "when": "view == planmyproject.tree && viewItem =~ /^task:/",
          "group": "inline@2"
        },
        {
          "command": "planmyproject.debateTask",
          "when": "view == planmyproject.tree && viewItem =~ /^task:/",
          "group": "inline@3"
        },
        {
          "command": "planmyproject.implementTask",
          "when": "view == planmyproject.tree && viewItem =~ /^task:/",
          "group": "inline@4"
        },
        {
          "command": "planmyproject.markResearchComplete",
          "when": "view == planmyproject.tree && (viewItem == task:research || viewItem == task:decision || viewItem == task:research:blocked || viewItem == task:decision:blocked)",
          "group": "inline@5"
        },
        {
          "command": "planmyproject.setTaskFileSendPolicy",
          "when": "view == planmyproject.tree && viewItem =~ /^task:/",
          "group": "inline@6"
        },
        {
          "command": "planmyproject.deleteTask",
          "when": "view == planmyproject.tree && viewItem =~ /^task:/",
          "group": "inline@7"
        },
        {
          "command": "planmyproject.showTaskRationale",
          "when": "view == planmyproject.tree && viewItem =~ /^task:/",
          "group": "navigation@1"
        },
        {
          "command": "planmyproject.viewLinkedFiles",
          "when": "view == planmyproject.tree && viewItem =~ /^task:/",
          "group": "navigation@2"
        },
        {
          "command": "planmyproject.viewDebateArchive",
          "when": "view == planmyproject.tree && viewItem =~ /^task:/",
          "group": "navigation@3"
        }
      ]
    },
    "configuration": {
      "title": "PlanMyProject",
      "properties": {
        "planmyproject.aiProvider": {
          "type": "string",
          "scope": "machine",
          "enum": [
            "copilot",
            "claude",
            "openai"
          ],
          "default": "copilot",
          "description": "AI provider used by PlanMyProject. Machine-scoped (P0-D1/§12.4): a workspace should not be able to silently redirect a user's prompts to a different provider than the one they configured."
        },
        "planmyproject.claudeApiKey": {
          "type": "string",
          "scope": "application",
          "default": "",
          "markdownDeprecationMessage": "**Deprecated.** Storing API keys in settings risks VCS exposure. Use the **PlanMyProject: Set API Key** command instead.",
          "description": "Anthropic Claude API key. Use 'PlanMyProject: Set API Key' command for secure storage. Application-scoped (P0-D1/§12.4) and one-way migrated to secret storage the first time it is read."
        },
        "planmyproject.openaiApiKey": {
          "type": "string",
          "scope": "application",
          "default": "",
          "markdownDeprecationMessage": "**Deprecated.** Storing API keys in settings risks VCS exposure. Use the **PlanMyProject: Set API Key** command instead.",
          "description": "OpenAI API key. Use 'PlanMyProject: Set API Key' command for secure storage. Application-scoped (P0-D1/§12.4) and one-way migrated to secret storage the first time it is read."
        },
        "planmyproject.sendFileContentsToAI": {
          "type": "boolean",
          "scope": "machine",
          "default": false,
          "description": "Global default for sending linked file contents to AI prompts. Machine-scoped (P0-D1/§12.4): a workspace cannot use this to turn on file egress a user has not opted into."
        },
        "planmyproject.defaultTaskFileSendPolicy": {
          "type": "string",
          "scope": "machine",
          "enum": [
            "global",
            "always",
            "never",
            "ask"
          ],
          "default": "global",
          "description": "Default per-task file send policy for new tasks. Machine-scoped (P0-D1/§12.4): a workspace cannot use this to default new tasks to always sending file contents."
        },
        "planmyproject.scanner.extractSignatures": {
          "type": "boolean",
          "scope": "window",
          "default": true,
          "description": "Extract function/class signatures during workspace scan."
        },
        "planmyproject.scanner.maxFilesScanned": {
          "type": "number",
          "scope": "window",
          "default": 500,
          "minimum": 50,
          "description": "Maximum number of files included in scan results."
        },
        "planmyproject.scanner.maxFileSizeKb": {
          "type": "number",
          "scope": "window",
          "default": 50,
          "minimum": 1,
          "description": "Maximum file size in KB for signature extraction."
        },
        "planmyproject.autoRescanOnImplement": {
          "type": "boolean",
          "scope": "window",
          "default": true,
          "description": "Automatically run workspace scan after successful task implementation."
        },
        "planmyproject.confidenceThreshold": {
          "type": "number",
          "scope": "window",
          "default": 0.5,
          "minimum": 0,
          "maximum": 1,
          "description": "Minimum confidence required to auto-commit AI-generated tasks. A workspace value may only raise this threshold, never lower it below the user's own value (P0-D1/§12.4, enforced in P0-D4)."
        },
        "planmyproject.researchGate": {
          "type": "boolean",
          "scope": "window",
          "default": true,
          "description": "Block implementation queue items until research/decision dependencies are done. A workspace may only turn this on if the user has it off, never turn it off if the user has it on (P0-D1/§12.4, enforced in P0-D4)."
        },
        "planmyproject.debate.archiveAfterDays": {
          "type": "number",
          "scope": "window",
          "default": 90,
          "minimum": 1,
          "description": "Archive debate entries older than this number of days."
        },
        "planmyproject.planFileName": {
          "type": "string",
          "scope": "window",
          "default": "planmyproject.md",
          "description": "Plan file name in workspace root."
        },
        "planmyproject.showRationaleInline": {
          "type": "boolean",
          "scope": "window",
          "default": true,
          "description": "Write AI-generated rationale lines below tasks in the plan file."
        },
        "planmyproject.gitignorePmpDir": {
          "type": "boolean",
          "scope": "window",
          "default": true,
          "description": "Offer .gitignore updates for scanner cache path under .pmp/."
        },
        "planmyproject.masking.maskEmails": {
          "type": "boolean",
          "scope": "window",
          "default": false,
          "description": "Redact email addresses from prompts sent to AI providers. Independent of the always-on secret patterns (API keys, tokens, connection strings), which are never optional."
        },
        "planmyproject.masking.maskIpAddresses": {
          "type": "boolean",
          "scope": "window",
          "default": false,
          "description": "Redact IP addresses from prompts sent to AI providers. Independent of the always-on secret patterns (API keys, tokens, connection strings), which are never optional."
        },
        "planmyproject.scanner.cacheTtlMinutes": {
          "type": "number",
          "scope": "window",
          "default": 5,
          "minimum": 0,
          "description": "How many minutes a workspace scan result is considered fresh. Set to 0 to always rescan before AI operations."
        },
        "planmyproject.requireAiConsent": {
          "type": "string",
          "scope": "machine",
          "enum": [
            "always",
            "first-per-session",
            "never"
          ],
          "enumDescriptions": [
            "Prompt before every AI operation.",
            "Prompt once per VS Code session; subsequent operations in the same session are allowed automatically.",
            "Never prompt — send context to AI without confirmation."
          ],
          "default": "first-per-session",
          "description": "Controls when PlanMyProject asks for confirmation before sending context to the AI provider. Machine-scoped (P0-D1/§12.4): a workspace cannot use this to turn off consent prompts a user has enabled."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile && npm run build",
    "compile": "rimraf out && tsc --noEmit -p ./ && node esbuild.js",
    "watch": "rimraf out && node esbuild.js --watch",
    "test:build": "rimraf out-test && tsc -p ./tsconfig.test.json",
    "test": "npm run test:build && NODE_PATH=./test/shims node --test out-test/test/*.test.js out-test/test/integration/*.test.js",
    "test:integration": "npm run test:build && NODE_PATH=./test/shims node --test out-test/test/integration/*.test.js",
    "test:coverage": "npm run test:build && NODE_PATH=./test/shims node --test --experimental-test-coverage out-test/test/*.test.js out-test/test/integration/*.test.js",
    "bench": "npm run test:build && NODE_PATH=./test/shims node --test out-test/test/bench/*.bench.js",
    "build": "node ./scripts/update-readme-build-status.js",
    "build:status": "npm run build",
    "check:coverage": "node scripts/check-feature-coverage.js",
    "check:settings-scope": "node scripts/check-settings-scope.js",
    "verify": "npm run build",
    "package": "npx @vscode/vsce package --no-yarn --no-dependencies",
    "publish:vsce": "npx @vscode/vsce publish --no-yarn --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.14.12",
    "@types/vscode": "^1.95.0",
    "@vscode/vsce": "^3.7.1",
    "esbuild": "^0.28.2",
    "rimraf": "^6.1.3",
    "typescript": "^5.6.2"
  }
}
